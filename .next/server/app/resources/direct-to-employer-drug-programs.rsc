b:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"Direct-to-Employer Drug Programs (DTE): What Employers Need to Know | ApalyRx"}],["$","meta","3",{"name":"description","content":"Direct-to-employer (DTE) drug programs let manufacturers bypass PBMs and offer pricing directly to employer-sponsored plans. Learn how DTE works, how it differs from DTC and DTP, what infrastructure is required, and how to bring these programs inside the benefit."}],["$","link","4",{"rel":"canonical","href":"https://www.apalyrx.com/resources/direct-to-employer-drug-programs"}],["$","meta","5",{"property":"og:title","content":"Direct-to-Employer Drug Programs (DTE) Explained | ApalyRx"}],["$","meta","6",{"property":"og:description","content":"Manufacturers are going direct. Learn what DTE means, how it compares to DTC and DTP, and what employers need to bring these programs inside the benefit."}],["$","meta","7",{"property":"og:url","content":"https://www.apalyrx.com/resources/direct-to-employer-drug-programs"}],["$","meta","8",{"property":"og:site_name","content":"ApalyRx"}],["$","meta","9",{"property":"og:type","content":"website"}],["$","meta","10",{"name":"twitter:card","content":"summary"}],["$","meta","11",{"name":"twitter:title","content":"Direct-to-Employer Drug Programs (DTE) Explained | ApalyRx"}],["$","meta","12",{"name":"twitter:description","content":"Manufacturers are going direct. Learn what DTE means, how it compares to DTC and DTP, and what employers need to bring these programs inside the benefit."}],["$","link","13",{"rel":"icon","href":"/favicon.png"}]]
