b:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"Drug Benefit Integrity (DBI): The Five-Requirement Standard for Pharmacy Benefits | ApalyRx"}],["$","meta","3",{"name":"description","content":"Drug Benefit Integrity (DBI) is an independent standard with five structural requirements ensuring pharmacy benefit decisions are made in the plan's interest. Learn the five requirements, why transparency alone isn't enough, and how DBI compares to integrity standards in financial services."}],["$","link","4",{"rel":"canonical","href":"https://www.apalyrx.com/resources/drug-benefit-integrity"}],["$","meta","5",{"property":"og:title","content":"Drug Benefit Integrity (DBI) Standard | ApalyRx"}],["$","meta","6",{"property":"og:description","content":"Five structural requirements ensuring pharmacy benefit decisions are made in the plan's interest. The independent standard for drug benefit verification."}],["$","meta","7",{"property":"og:url","content":"https://www.apalyrx.com/resources/drug-benefit-integrity"}],["$","meta","8",{"property":"og:site_name","content":"ApalyRx"}],["$","meta","9",{"property":"og:type","content":"website"}],["$","meta","10",{"name":"twitter:card","content":"summary"}],["$","meta","11",{"name":"twitter:title","content":"Drug Benefit Integrity (DBI) Standard | ApalyRx"}],["$","meta","12",{"name":"twitter:description","content":"Five structural requirements ensuring pharmacy benefit decisions are made in the plan's interest. The independent standard for drug benefit verification."}],["$","link","13",{"rel":"icon","href":"/favicon.png"}]]
